    "AUDIT_SQL_SERVER": "<sql-server>.database.windows.net",
    "AUDIT_SQL_DATABASE": "auditdb",
    "AUDIT_SQL_AUTH": "ActiveDirectoryDefault",
    "AZURE_OPENAI_ENDPOINT": "https://<foundry-resource>.openai.azure.com",
    "AZURE_OPENAI_DEPLOYMENT": "gpt-4.1-mini",
